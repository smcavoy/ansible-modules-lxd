class Test:
    """One target or scenario."""

    def __init__(self, kind: str, name: str, path: Path) -> None:
        self.kind = kind
        self.name = name
        self.path = path
        self.goal = ""
        self.aliases: set[str] = set()
        aliases_file = path / "aliases"
        if aliases_file.exists():
            self.aliases = {
                line.strip() for line in aliases_file.read_text().splitlines()
                if line.strip() and not line.startswith("#")
            }
        goal_file = path / ("main.yml" if kind == "scenario" else "tasks/main.yml")
        if goal_file.exists():
            for line in goal_file.read_text().splitlines():
                if line.startswith("# Goal:"):
                    self.goal = line[len("# Goal:"):].strip()
                    break
        self.status = "skip"
        self.reason = ""
        self.seconds = 0.0
        self.log = ""

    @property
    def fixture(self) -> str:
        """Return the fixture alias, for example C(lxd/standalone)."""
        for alias in self.aliases:
            if alias in ("lxd/standalone", "lxd/cluster", "lxd/cluster-new", "lxd/ovn", "lxd/ceph", "lxd/multicluster"):
                return alias
        return "lxd/standalone"


def kill_group(pgid: int) -> None:
    """Stop every process left in a process group."""
    try:
        os.killpg(pgid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass


def stop_old_processes(run_id: str) -> None:
    """Stop processes that an earlier run left in the runner. Only the run that holds the lock calls this."""
    mine = str(WORK / run_id)
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            cmdline = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        if str(WORK) + "/" in cmdline and mine not in cmdline:
            try:
                os.kill(int(entry.name), signal.SIGKILL)
                log(f"stopped process {entry.name} of an earlier run: {cmdline[:120]}")
            except (ProcessLookupError, PermissionError):
                pass


def discover(collection: Path, names: list[str], kinds: set[str]) -> list[Test]:
    """Find the targets and scenarios to run."""
    tests: list[Test] = []
    if "target" in kinds:
        for path in sorted((collection / "tests/integration/targets").glob("*")):
            if path.is_dir() and not path.name.startswith("setup_"):
                tests.append(Test("target", path.name, path))
    if "scenario" in kinds:
        for path in sorted((collection / "tests/scenarios").glob("*")):
            if (path / "main.yml").exists():
                tests.append(Test("scenario", path.name, path))
    if names:
        tests = [test for test in tests if test.name in names]
    return tests


class Slot:
    """One sandbox and one copy of the collection."""

    def __init__(self, run: Run, number: int) -> None:
        self.run = run
        self.number = number
        self.dir = run.dir / f"slot-{number}"
        self.home = self.dir / "home"
        self.collection = self.dir / "ansible_collections" / "smcavoy" / "lxd"
        self.sandbox = Sandbox(run.host, f"sbx-{run.run_id}-{number}", run.args.image)
        self.config = self.collection / "tests/integration/integration_config.yml"
        self.failed = False
        # The error text when the sandbox of this slot did not start. Such a slot runs no test.
        self.start_error = ""

    def prepare(self) -> None:
        """Copy the collection, start the sandbox, and write the config."""
        shutil.copytree(self.run.collection, self.collection, ignore=ignore_copy)
        self.home.mkdir(parents=True, exist_ok=True)
        log(f"slot {self.number}: launching {self.sandbox.name}")
        started = time.monotonic()
        self.sandbox.launch()
        self.sandbox.wait_ready()
        log(f"slot {self.number}: {self.sandbox.name} ready in {time.monotonic() - started:.0f} s at {self.sandbox.ip}")
        server_cert = self.sandbox.server_cert(self.dir / "server.crt")
        meta = TEST_IMAGES / "alpine-ct.meta"
        root = TEST_IMAGES / "alpine-ct.root"
        if meta.exists() and root.exists():
            self.sandbox.upload_split_image(meta, root, "test/alpine-ct")
        values = {
            "lxd_url": self.sandbox.url,
            "lxd_client_cert": self.sandbox.cert,
            "lxd_client_key": self.sandbox.key,
            "lxd_server_cert": server_cert,
            "lxd_run_id": self.run.run_id,
            "lxd_slot": self.number,
            "lxd_sandbox_ip": self.sandbox.ip,
            "lxd_sandbox_name": self.sandbox.name,
            "lxd_fixture": "standalone",
            # The host LXD of the sandbox VM, for targets that act inside the VM (lxd_fault_server).
            "lxd_host_remote": self.run.host.remote,
            "lxd_host_project": self.run.host.project,
            "lxd_image_ct": "test/alpine-ct",
            "lxd_image_ct_meta": str(meta),
            "lxd_image_ct_rootfs": str(root),
            "lxd_image_vm_meta": str(TEST_IMAGES / "alpine-vm.meta"),
            "lxd_image_vm_rootfs": str(TEST_IMAGES / "alpine-vm.root"),
            "lxd_pool": "default",
            "lxd_members": [],
        }
        self.config.parent.mkdir(parents=True, exist_ok=True)
        self.config.write_text(json.dumps(values, indent=2) + "\n")

    def cleanup(self) -> None:
        """Delete the sandbox of this slot."""
        self.sandbox.delete()

    def env(self) -> dict[str, str]:
        """Return the environment for ansible commands."""
        env = dict(os.environ)
        env.update({
            "HOME": str(self.home),
            "PATH": f"{VENV / 'bin'}:{env.get('PATH', '')}",
            "ANSIBLE_COLLECTIONS_PATH": str(self.dir),
            "ANSIBLE_FORCE_COLOR": "0",
            "ANSIBLE_NOCOLOR": "1",
            "ANSIBLE_PYTHON_INTERPRETER": str(VENV / "bin/python"),
            "ANSIBLE_STDOUT_CALLBACK": "default",
            "ANSIBLE_CALLBACK_RESULT_FORMAT": "yaml",
            "ANSIBLE_SHOW_TASK_PATH_ON_FAILURE": "1",
        })
        return env

    def execute(self, test: Test) -> None:
        """Run one test on this slot. Mark the slot as failed when the test does not pass."""
        if test.kind == "scenario":
            cmd = [
                str(VENV / "bin/ansible-playbook"), "-i", "localhost,", "-c", "local",
                str(self.collection / "tests/scenarios" / test.name / "main.yml"),
                "-e", f"@{self.config}",
            ]
            cwd = self.collection / "tests/scenarios" / test.name
        else:
            cmd = [
                str(VENV / "bin/ansible-test"), "integration", "--allow-unsupported", "--local",
                "--color", "no", test.name,
            ]
            cwd = self.collection
        if self.run.args.verbose:
            cmd.append("-vvv")
        started = time.monotonic()
        # The test gets its own process group. On a time limit, the runner stops the whole group, so that no playbook
        # or module goes on against the sandbox while the next test runs.
        proc = subprocess.Popen(
            cmd, cwd=cwd, env=self.env(), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, errors="replace", start_new_session=True,
        )
        try:
            out, err = proc.communicate(timeout=self.run.args.timeout * 60)
            test.log = out + err
            test.status = "pass" if proc.returncode == 0 else "fail"
            if proc.returncode != 0:
                test.reason = last_failure(test.log)
        except subprocess.TimeoutExpired:
            kill_group(proc.pid)
            out, err = proc.communicate()
            test.log = (out or "") + (err or "")
            test.status = "timeout"
            test.reason = f"longer than {self.run.args.timeout} minutes"
        finally:
            kill_group(proc.pid)
        test.seconds = time.monotonic() - started
        (self.run.dir / "logs").mkdir(exist_ok=True)
        (self.run.dir / "logs" / f"{test.kind}-{test.name}.log").write_text(test.log)
        log(f"slot {self.number}: {test.status.upper():7} {test.kind} {test.name} ({test.seconds:.0f} s)")
        if test.status != "pass":
            self.failed = True


class ClusterSlot(Slot):
    """A slot with a cluster of three sandbox members, for tests with the alias lxd/cluster."""

    def __init__(self, run: Run, number: int) -> None:
        super().__init__(run, number)
        self.members = [Sandbox(run.host, f"sbx-{run.run_id}-c{index}", run.args.image) for index in range(1, CLUSTER_MEMBERS + 1)]
        self.sandbox = self.members[0]

    def prepare(self) -> None:
        """Start the members, form the cluster, and write the config."""
        shutil.copytree(self.run.collection, self.collection, ignore=ignore_copy)
        self.home.mkdir(parents=True, exist_ok=True)
        started = time.monotonic()
        # The first-boot unit skips the preseed in cluster mode. It only sets the HTTPS address and trusts the test client.
        for member in self.members:
            log(f"slot {self.number}: launching cluster member {member.name}")
            member.launch(cpu=1, memory_gib=CLUSTER_MEMBER_MEMORY_GIB, extra=("user.sandbox.mode=cluster",))
        for member in self.members:
            member.wait_ready()
        self.form_cluster()
        log(f"slot {self.number}: cluster of {len(self.members)} members ready in {time.monotonic() - started:.0f} s")
        first = self.members[0]
        meta = TEST_IMAGES / "alpine-ct.meta"
        root = TEST_IMAGES / "alpine-ct.root"
        if meta.exists() and root.exists():
            first.upload_split_image(meta, root, "test/alpine-ct")
        server_cert = first.server_cert(self.dir / "server.crt")
        values = {
            "lxd_url": first.url,
            "lxd_client_cert": first.cert,
            "lxd_client_key": first.key,
            "lxd_server_cert": server_cert,
            "lxd_run_id": self.run.run_id,
            "lxd_slot": self.number,
            "lxd_sandbox_ip": first.ip,
            "lxd_sandbox_name": first.name,
            "lxd_fixture": "cluster",
            "lxd_members": [member.name for member in self.members],
            "lxd_cluster_pool_dirs": list(CLUSTER_POOL_DIRS),
            "lxd_pool": "",
            "lxd_image_ct": "test/alpine-ct",
        }
        self.config.parent.mkdir(parents=True, exist_ok=True)
        self.config.write_text(json.dumps(values, indent=2) + "\n")

    def form_cluster(self) -> None:
        """Form the cluster with lxc commands: enable on the first member, then join the others."""
        first = self.members[0]
        dirs = " ".join(CLUSTER_POOL_DIRS)
        for member in self.members:
            self.run.host.exec(member.name, f"mkdir -p {dirs}")
        self.run.host.exec(
            first.name,
            f"lxc config set core.https_address {first.ip}:8443 </dev/null && "
            f"lxc config set cluster.https_address {first.ip}:8443 </dev/null && "
            f"lxc cluster enable {first.name} </dev/null",
        )
        for member in self.members[1:]:
            token = self.run.host.exec(first.name, f"lxc cluster add {member.name} --quiet </dev/null").strip()
            if not token:
                raise RunError(f"no join token for {member.name}")
            preseed = (
                "cluster:\n"
                "  enabled: true\n"
                f"  server_name: {member.name}\n"
                f"  server_address: {member.ip}:8443\n"
                f"  cluster_token: {token}\n"
            )
            self.run.host.exec(
                member.name,
                "lxc config unset core.https_address </dev/null; "
                f"printf '%s' '{preseed}' > /root/join.yaml && lxd init --preseed < /root/join.yaml && rm -f /root/join.yaml",
            )
        members = first.api("GET", "/1.0/cluster/members?recursion=1").get("metadata") or []
        online = [item.get("server_name") for item in members if item.get("status") == "Online"]
        if len(online) != len(self.members):
            raise RunError(f"the cluster has {len(online)} online members, not {len(self.members)}: {online}")

    def cleanup(self) -> None:
        """Delete all members."""
        for member in self.members:
            member.delete()


