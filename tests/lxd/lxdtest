LOCK_MINUTES = 20
LOCK_BEAT_SECONDS = 300
# A VM with a Ceph OSD can take minutes to stop under load.
DELETE_TIMEOUT = 300
# A run deletes sandboxes of earlier runs that are older than this, after it takes the lock.
# The limit keeps the sandboxes of a recent --keep-on-failure run for a person to look at.
LEFTOVER_HOURS = 6


def runner_cpus() -> int:
    """Return the CPUs of this runner. LXD pins a container with a numeric limits.cpu to that many CPUs."""
    try:
        return len(os.sched_getaffinity(0))
    except (AttributeError, OSError):
        return os.cpu_count() or 1


