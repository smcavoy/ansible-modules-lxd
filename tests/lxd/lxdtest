# Sandbox API


class Sandbox:
    """One nested LXD server in a VM."""

    def __init__(self, host: Host, name: str, image: str) -> None:
        self.host = host
        self.name = name
        self.image = image
        self.url = f"https://{name}:8443"
        self.ip = ""
        self.cert = str(PKI / "client.crt")
        self.key = str(PKI / "client.key")

    def context(self, server_cert: str | None = None) -> ssl.SSLContext:
        """Return a TLS context with the client certificate."""
        if server_cert:
            ctx = ssl.create_default_context(cafile=server_cert)
        else:
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
        ctx.load_cert_chain(self.cert, self.key)
        return ctx

    def api(self, method: str, path: str, body: object = None, data: bytes | None = None,
            headers: dict | None = None, timeout: int = 60) -> dict:
        """Call the sandbox API. Wait for an async operation."""
        send = dict(headers or {})
        payload = data
        if body is not None:
            payload = json.dumps(body).encode()
            send["Content-Type"] = "application/json"
        req = urllib.request.Request(self.url + path, data=payload, method=method, headers=send)
        with urllib.request.urlopen(req, context=self.context(), timeout=timeout) as resp:
            env = json.loads(resp.read() or b"{}")
        if env.get("type") == "async":
            op = env["operation"].rsplit("/", 1)[-1]
            req = urllib.request.Request(f"{self.url}/1.0/operations/{op}/wait?timeout=600", method="GET")
            with urllib.request.urlopen(req, context=self.context(), timeout=660) as resp:
                waited = json.loads(resp.read())
            meta = waited.get("metadata") or {}
            if meta.get("status") != "Success":
                raise RunError(f"sandbox operation failed: {meta.get('err')}")
            return meta
        return env

    def launch(self, cpu: int = 2, memory_gib: int = SLOT_MEMORY_GIB, extra: tuple[str, ...] = (), root_gib: int = SANDBOX_ROOT_GIB) -> None:
        """Launch the sandbox VM."""
        options: list[str] = []
        for item in extra:
            options += ["-c", item]
        self.host.write(
            "launch", self.image, self.host.name(self.name), "--vm",
            "-c", f"limits.cpu={cpu}", "-c", f"limits.memory={memory_gib}GiB",
            *options,
            "-d", f"root,size={root_gib}GiB",
            done=self.recover,
        )

    def recover(self) -> bool:
        """After a failed launch, start the VM when LXD created it. Return whether it runs."""
        status = self.host.status(self.name)
        if status and status != "Running":
            self.host.start(self.name)
            status = self.host.status(self.name)
        return status == "Running"

    def wait_ready(self) -> None:
        """Wait until the sandbox trusts the client certificate."""
        deadline = time.monotonic() + SANDBOX_READY_TIMEOUT
        last = ""
        while time.monotonic() < deadline:
            try:
                env = self.api("GET", "/1.0", timeout=10)
                if (env.get("metadata") or {}).get("auth") == "trusted":
                    self.ip = socket.gethostbyname(self.name)
                    MONITOR.add(self)
                    return
                last = "not trusted yet"
            except (urllib.error.URLError, OSError, ValueError) as exc:
                last = str(exc)
            time.sleep(3)
        raise RunError(f"sandbox {self.name} did not become ready in {SANDBOX_READY_TIMEOUT} s: {last}")

    def server_cert(self, path: Path) -> str:
        """Write the server certificate of the sandbox to O(path)."""
        env = self.api("GET", "/1.0")
        pem = ((env.get("metadata") or {}).get("environment") or {}).get("certificate") or ""
        path.write_text(pem)
        return str(path)

    def upload_split_image(self, metadata: Path, rootfs: Path, alias: str) -> None:
        """Upload a split image and give it an alias."""
        boundary = uuid.uuid4().hex
        parts = []
        for field, path in (("metadata", metadata), ("rootfs", rootfs)):
            parts.append(
                f"--{boundary}\r\nContent-Disposition: form-data; name=\"{field}\"; filename=\"{path.name}\"\r\n"
                f"Content-Type: application/octet-stream\r\n\r\n".encode() + path.read_bytes() + b"\r\n"
            )
        data = b"".join(parts) + f"--{boundary}--\r\n".encode()
        meta = self.api(
            "POST", "/1.0/images", data=data,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}", "X-LXD-public": "false"},
            timeout=300,
        )
        fingerprint = (meta.get("metadata") or {}).get("fingerprint")
        if not fingerprint:
            raise RunError("image upload returned no fingerprint")
        self.api("POST", "/1.0/images/aliases", body={"name": alias, "target": fingerprint})

    def diagnostics(self) -> None:
        """Print the TCP reset counters of the sandbox.

        TcpExtTCPAbortOnData counts data that came after LXD closed a socket, for example after a slow TLS handshake.
        TcpExtTCPAbortOnTimeout counts downloads that LXD ended after the client stopped reading for 10 s.
        """
        script = (
            "nstat -az 2>/dev/null "
            "| grep -E '^(TcpExtTCPAbortOn[A-Za-z]+|TcpOutRsts|TcpEstabResets|TcpAttemptFails|TcpExtListenOverflows|TcpExtListenDrops)[[:space:]]' "
            "| awk '{printf \"%s=%s \", $1, $2} END {print \"\"}'"
        )
        try:
            out = self.host.exec(self.name, script, timeout=60)
        except RunError as exc:
            out = f"no diagnostics: {exc}"
        for line in out.strip().splitlines():
            log(f"PROBE {self.name}: {line}")
        guarded(f"disk use of {self.name}", self.disk_use)

    def disk_use(self) -> None:
        """Print the disk use of the sandbox: what the guest uses now, and what the volumes hold on the host.

        The volume number of a VM grows with each new block that the guest writes, so it is close to the peak.
        The sizes of the root disks come from these numbers (see the DISK lines in a full run).
        """
        gib = 1024**3
        try:
            guest = self.host.exec(self.name, "df -B1 --output=used,size / | tail -1", timeout=60).split()
            log(f"PROBE {self.name}: DISK guest root used {int(guest[0]) / gib:.1f} GiB of {int(guest[1]) / gib:.1f} GiB")
        except (RunError, ValueError, IndexError) as exc:
            log(f"PROBE {self.name}: DISK guest unknown: {exc}")
        try:
            # lxc info prints "Disk usage:" and one "  <device>: <size>" line per disk.
            info = self.host.lxc("info", self.host.name(self.name), timeout=60)
            block = info.split("Disk usage:", 1)[1] if "Disk usage:" in info else ""
            lines = []
            for line in block.splitlines()[1:]:
                if not line.startswith("    "):
                    break  # The next section, for example "Disk total:".
                lines.append(line.strip())
            for line in lines or ["none: not reported"]:
                log(f"PROBE {self.name}: DISK volume {line}")
        except RunError as exc:
            log(f"PROBE {self.name}: DISK volume unknown: {exc}")

    def delete(self) -> None:
        """Delete the sandbox VM."""
        if self.ip:
            guarded(f"probe of {self.name}", lambda: MONITOR.remove(self))
            guarded(f"diagnostics of {self.name}", self.diagnostics)
            self.ip = ""
        self.host.lxc("delete", self.host.name(self.name), "--force", check=False, timeout=DELETE_TIMEOUT)


