# lxc helpers


WRITE_VERBS = {
    "launch", "init", "start", "stop", "restart", "create", "set", "unset", "add", "remove", "copy", "move",
    "exec", "push", "publish", "import", "attach", "detach", "edit", "rename", "override",
}


def is_safe_to_repeat(args: tuple[str, ...]) -> bool:
    """Return whether an lxc command can run twice with no harm: a read, or a forced delete."""
    words = [arg for arg in args[:4] if not arg.startswith("-")]
    if words and words[0] == "delete":
        return True
    return not any(word in WRITE_VERBS for word in words)


def lock_expiry(minutes: int) -> str:
    """Return the expiry time of a lock that lives O(minutes) from now."""
    return (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(minutes=minutes)).isoformat()


class LockBeat(threading.Thread):
    """Renew the run lock every LOCK_BEAT_SECONDS while the run lives."""

    def __init__(self, host: Host, owner: str) -> None:
        super().__init__(name="lock-beat", daemon=True)
        self.host = host
        self.owner = owner
        self.done = threading.Event()

    def run(self) -> None:
        while not self.done.wait(LOCK_BEAT_SECONDS):
            try:
                if not self.host.renew_lock(self.owner, LOCK_MINUTES):
                    log(f"lock: {self.owner} no longer holds {LOCK_NAME}; renewal stops")
                    return
            except RunError as exc:
                log(f"lock: renewal failed, trying again in {LOCK_BEAT_SECONDS} s: {exc}")

    def stop(self) -> None:
        self.done.set()


class Host:
    """The host LXD, reached with the lxc client and a restricted certificate."""

    def __init__(self, remote: str, project: str) -> None:
        self.remote = remote
        self.project = project

    def lxc(self, *args: str, timeout: int = CALL_TIMEOUT, check: bool = True, retry: bool | None = None) -> str:
        """Run one lxc command with stdin closed and a time limit.

        A read or a forced delete gets one retry. A write that creates or changes something gets none, because a retry after
        a time limit can repeat a write that LXD already did. Use L(write) for such a write.
        With O(check=False), a failure or a time limit returns an empty string and never raises.
        """
        cmd = ["lxc", *args, "--project", self.project]
        if retry is None:
            retry = is_safe_to_repeat(args)
        attempts = 2 if retry else 1
        last = ""
        for attempt in range(attempts):
            try:
                proc = subprocess.run(
                    cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace", timeout=timeout, check=False
                )
            except subprocess.TimeoutExpired:
                last = f"timeout after {timeout} s"
                continue
            if proc.returncode == 0:
                return proc.stdout
            last = (proc.stderr or proc.stdout).strip()
            if not check:
                return ""
            if attempt + 1 < attempts:
                time.sleep(5)
        if not check:
            log(f"lxc {' '.join(args)}: {last}")
            return ""
        raise RunError(f"lxc {' '.join(args)} failed: {last}")

    def write(self, *args: str, done: t.Callable[[], bool], timeout: int = CALL_TIMEOUT) -> None:
        """Run one lxc write without a retry. When it fails, accept it if O(done) shows that LXD did the work anyway."""
        try:
            self.lxc(*args, timeout=timeout, retry=False)
        except RunError as exc:
            if not done():
                raise
            log(f"lxc {args[0]} reported an error, but the result is in place: {exc}")

    def status(self, instance: str) -> str:
        """Return the status of an instance, for example Running, or an empty string when it does not exist."""
        for item in self.instances():
            if item.get("name") == instance:
                return str(item.get("status") or "")
        return ""

    def start(self, instance: str) -> None:
        """Start an instance. Accept an instance that is already running."""
        self.write("start", self.name(instance), done=lambda: self.status(instance) == "Running")

    def name(self, instance: str) -> str:
        """Return the remote-qualified instance name."""
        return f"{self.remote}:{instance}"

    def exec(self, instance: str, script: str, timeout: int = CALL_TIMEOUT) -> str:
        """Run a shell script in an instance. The project flag goes before "--", so it does not reach the script."""
        cmd = ["lxc", "exec", self.name(instance), "--project", self.project, "--", "sh", "-c", script]
        try:
            proc = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout, check=False)
        except subprocess.TimeoutExpired as exc:
            raise RunError(f"exec in {instance} took longer than {timeout} s") from exc
        if proc.returncode != 0:
            raise RunError(f"exec in {instance} failed: {(proc.stderr or proc.stdout).strip()[-500:]}")
        return proc.stdout

    def cpu_limit(self) -> int:
        """Return the limits.cpu of the project, or 0 when it has none."""
        value = self.lxc("project", "get", f"{self.remote}:{self.project}", "limits.cpu", check=False, timeout=60).strip()
        return int(value) if value.isdigit() else 0

    def instances(self) -> list[dict]:
        """Return the instances of the project."""
        return json.loads(self.lxc("list", f"{self.remote}:", "--format", "json", timeout=60))

    def take_lock(self, owner: str, minutes: int, wait_seconds: int, adopt: str = "") -> None:
        """Create the lock container. Wait while another run holds it.

        With O(adopt), take over a lock whose owner is O(adopt). ci/bootstrap.py hands its lock to the test run this way.
        """
        deadline = time.monotonic() + wait_seconds
        while True:
            expires = lock_expiry(minutes)
            try:
                self.lxc(
                    "init", "--empty", self.name(LOCK_NAME),
                    "-c", f"user.lock.owner={owner}", "-c", f"user.lock.expires={expires}",
                    timeout=60, retry=False,
                )
                return
            except RunError as exc:
                if "already exists" not in str(exc):
                    raise
            if adopt and self.lock_owner() == adopt:
                self.lxc("config", "set", self.name(LOCK_NAME), f"user.lock.owner={owner}", f"user.lock.expires={expires}", timeout=60)
                log(f"Took over the lock from {adopt}.")
                return
            if self.lock_expired():
                log("Lock is stale. Removing it.")
                self.lxc("delete", self.name(LOCK_NAME), "--force", check=False)
                continue
            if time.monotonic() >= deadline:
                raise RunError("test server busy: another run holds the lock")
            log("Another run holds the lock. Waiting 60 s.")
            time.sleep(60)

    def renew_lock(self, owner: str, minutes: int) -> bool:
        """Move the expiry of the lock on, if O(owner) still holds it. Return whether it did."""
        if self.lock_owner() != owner:
            return False
        self.lxc("config", "set", self.name(LOCK_NAME), f"user.lock.expires={lock_expiry(minutes)}", timeout=60)
        return True

    def lock_owner(self) -> str:
        """Return the owner of the current lock, or an empty string."""
        return self.lxc("config", "get", self.name(LOCK_NAME), "user.lock.owner", check=False, timeout=60).strip()

    def lock_expired(self) -> bool:
        """Return whether the current lock is past its expiry."""
        value = self.lxc("config", "get", self.name(LOCK_NAME), "user.lock.expires", check=False, timeout=60).strip()
        if not value:
            return False
        try:
            return datetime.datetime.fromisoformat(value) < datetime.datetime.now(datetime.timezone.utc)
        except ValueError:
            return True

    def release_lock(self) -> None:
        """Delete the lock container."""
        self.lxc("delete", self.name(LOCK_NAME), "--force", check=False, timeout=60)


