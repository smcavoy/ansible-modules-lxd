# Probe for the connection resets


class ConnMonitor:
    """Measure TLS handshakes to the sandboxes and the scheduling stalls of the runner.

    LXD closes a connection whose TLS handshake takes longer than 3 s (the ReadHeaderTimeout of its HTTP server).
    The numbers show how close a run comes to that limit.
    """

    TICK = 1.0
    PROBE_EVERY = 5

    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.sandboxes: list[Sandbox] = []
        self.samples: dict[str, list[float]] = {}
        self.errors: dict[str, list[str]] = {}
        self.stalls: list[tuple[float, str]] = []
        self.ticks = 0
        self.stop = threading.Event()
        self.thread: threading.Thread | None = None

    def add(self, sandbox: Sandbox) -> None:
        """Start to probe a sandbox."""
        with self.lock:
            self.sandboxes.append(sandbox)
            self.samples.setdefault(sandbox.name, [])
            self.errors.setdefault(sandbox.name, [])

    def remove(self, sandbox: Sandbox) -> None:
        """Stop to probe a sandbox and print its numbers."""
        with self.lock:
            if sandbox in self.sandboxes:
                self.sandboxes.remove(sandbox)
        self.report(sandbox.name)

    def start(self) -> None:
        """Start the probe thread."""
        log(f"PROBE runner pressure at start: {self.pressure()}")
        self.thread = threading.Thread(target=self.loop, daemon=True)
        self.thread.start()

    def finish(self) -> None:
        """Stop the probe thread and print the stalls of the runner."""
        self.stop.set()
        if self.thread:
            self.thread.join(timeout=60)
        log(f"PROBE runner pressure at end: {self.pressure()}")
        stalls = sorted(self.stalls, key=lambda item: -item[0])
        over = {limit: sum(1 for value, _ in stalls if value >= limit) for limit in (1, 3, 10)}
        log(f"PROBE runner stalls: {self.ticks} ticks, over 1 s {over[1]}, over 3 s {over[3]}, over 10 s {over[10]}")
        for value, stamp in stalls[:10]:
            log(f"PROBE runner stall {value:.1f} s at {stamp}")

    @staticmethod
    def pressure() -> str:
        """Return the PSI totals of the runner cgroup, in seconds."""
        parts = []
        for kind in ("cpu", "memory", "io"):
            for path in (Path(f"/sys/fs/cgroup/{kind}.pressure"), Path(f"/proc/pressure/{kind}")):
                try:
                    text = path.read_text()
                except OSError:
                    continue
                for line in text.splitlines():
                    fields = dict(item.split("=") for item in line.split()[1:])
                    parts.append(f"{kind}.{line.split()[0]}={int(fields.get('total', '0')) / 1e6:.0f}s")
                break
        return " ".join(parts) or "not available"

    def loop(self) -> None:
        """Sleep one tick at a time. Record each oversleep. Probe each sandbox every few ticks."""
        while not self.stop.is_set():
            started = time.monotonic()
            time.sleep(self.TICK)
            late = time.monotonic() - started - self.TICK
            self.ticks += 1
            if late >= 0.5:
                self.stalls.append((late, datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S")))
            if self.ticks % self.PROBE_EVERY:
                continue
            with self.lock:
                targets = list(self.sandboxes)
            for sandbox in targets:
                self.probe(sandbox)

    def probe(self, sandbox: Sandbox) -> None:
        """Do one TLS handshake and one GET on a new connection. Record the handshake time or the error."""
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S")
        phase = "connect"
        try:
            with socket.create_connection((sandbox.ip, 8443), timeout=30) as raw:
                phase = "handshake"
                started = time.monotonic()
                with sandbox.context().wrap_socket(raw) as conn:
                    shake = time.monotonic() - started
                    phase = "request"
                    conn.sendall(f"GET /1.0 HTTP/1.1\r\nHost: {sandbox.name}\r\nConnection: close\r\n\r\n".encode())
                    phase = "response"
                    data = b""
                    while chunk := conn.recv(65536):
                        data += chunk
                    if not data.startswith(b"HTTP/1.1 200"):
                        raise OSError(f"unexpected answer {data[:40]!r}")
            with self.lock:
                self.samples[sandbox.name].append(shake)
        except (OSError, ssl.SSLError) as exc:
            with self.lock:
                self.errors[sandbox.name].append(f"{stamp} {phase}: {type(exc).__name__}: {exc}")

    def report(self, name: str) -> None:
        """Print the handshake numbers of one sandbox."""
        with self.lock:
            values = sorted(self.samples.get(name) or [])
            errors = list(self.errors.get(name) or [])
        if values:
            p99 = values[min(len(values) - 1, int(len(values) * 0.99))]
            slow = {limit: sum(1 for value in values if value >= limit) for limit in (1, 2, 3)}
            log(
                f"PROBE {name}: {len(values)} handshakes, median {values[len(values) // 2] * 1000:.0f} ms, p99 {p99 * 1000:.0f} ms, "
                f"max {values[-1] * 1000:.0f} ms, over 1 s {slow[1]}, over 2 s {slow[2]}, over 3 s {slow[3]}, errors {len(errors)}"
            )
        for error in errors[:20]:
            log(f"PROBE {name}: error {error}")


