class MicroCloudSlot(Slot):
    """A slot with a MicroCloud of three members, for tests with the alias lxd/ovn or lxd/ceph.

    Each member has a VLAN interface without an address for the OVN uplink, and a block volume for one Ceph OSD.
    The members run C(microcloud preseed) at the same time. Then the initiator trusts the test client.
    """

    def __init__(self, run: Run, number: int) -> None:
        super().__init__(run, number)
        self.members = [Sandbox(run.host, f"sbx-{run.run_id}-mc{index}", run.args.image) for index in range(1, MICROCLOUD_MEMBERS + 1)]
        self.sandbox = self.members[0]
        self.volumes: list[str] = []

    def bridge(self) -> tuple[str, str, str]:
        """Return the pool of the default profile, the CI bridge, and its IPv4 address with the prefix."""
        host = self.run.host
        pool = host.lxc("profile", "device", "get", f"{host.remote}:default", "root", "pool").strip()
        network = host.lxc("profile", "device", "get", f"{host.remote}:default", "eth0", "network").strip()
        address = host.lxc("network", "get", f"{host.remote}:{network}", "ipv4.address").strip()
        if not (pool and network and "/" in address):
            raise RunError(f"cannot read the pool, the bridge, or its address: {pool!r} {network!r} {address!r}")
        return pool, network, address

    def launch_member(self, member: Sandbox, pool: str) -> None:
        """Create a member VM with the Ceph disk, then start it."""
        host = self.run.host
        volume = f"{member.name}-ceph"
        host.write(
            "storage", "volume", "create", f"{host.remote}:{pool}", volume, "--type=block", f"size={MICROCLOUD_CEPH_GIB}GiB",
            done=lambda: bool(host.lxc("storage", "volume", "show", f"{host.remote}:{pool}", volume, check=False)),
        )
        self.volumes.append(volume)
        host.write(
            "init", self.run.args.image, host.name(member.name), "--vm",
            "-c", f"limits.cpu={MICROCLOUD_CPU}", "-c", f"limits.memory={MICROCLOUD_MEMORY_GIB}GiB",
            "-c", "user.sandbox.mode=microcloud",
            "-d", f"root,size={MICROCLOUD_ROOT_GIB}GiB",
            done=lambda: bool(host.status(member.name)),
        )
        host.write(
            "config", "device", "add", host.name(member.name), "ceph", "disk", f"pool={pool}", f"source={volume}",
            done=lambda: host.lxc("config", "device", "get", host.name(member.name), "ceph", "source", check=False).strip() == volume,
        )
        host.start(member.name)

    def wait_booted(self, member: Sandbox) -> None:
        """Wait until the first-boot unit of a member is done, and read its address."""
        deadline = time.monotonic() + SANDBOX_READY_TIMEOUT
        last = ""
        while time.monotonic() < deadline:
            try:
                self.run.host.exec(member.name, "test -e /var/lib/lxd-sandbox/done", timeout=30)
                member.ip = self.run.host.exec(member.name, "ip -4 -o route get 1.1.1.1 | sed -n 's/.* src \\([0-9.]*\\).*/\\1/p'", timeout=30).strip()
                if member.ip:
                    return
                last = "no address yet"
            except RunError as exc:
                last = str(exc)
            time.sleep(5)
        raise RunError(f"member {member.name} did not finish its first boot in {SANDBOX_READY_TIMEOUT} s: {last}")

    def preseed(self, subnet: str) -> str:
        """Return the MicroCloud preseed for all members."""
        lines = [
            f"initiator: {self.members[0].name}",
            f"lookup_subnet: {subnet}",
            "lookup_timeout: 300",
            f"session_passphrase: lxdtest-{self.run.run_id}-{uuid.uuid4().hex}",
            "session_timeout: 900",
            "systems:",
        ]
        for member in self.members:
            lines += [
                f"- name: {member.name}",
                f"  ovn_uplink_interface: {OVN_UPLINK_INTERFACE}",
                "  storage:",
                "    ceph:",
                "    - path: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_lxd_ceph",
                "      wipe: true",
            ]
        lines += [
            "ovn:",
            f"  ipv4_gateway: {OVN_UPLINK_GATEWAY}",
            f"  ipv4_range: {OVN_UPLINK_RANGE}",
        ]
        return "\n".join(lines) + "\n"

    def prepare(self) -> None:
        """Start the members, run MicroCloud on all of them, trust the test client, and write the config."""
        shutil.copytree(self.run.collection, self.collection, ignore=ignore_copy)
        self.home.mkdir(parents=True, exist_ok=True)
        started = time.monotonic()
        pool, network, gateway = self.bridge()
        log(f"slot {self.number}: MicroCloud on bridge {network} ({gateway}), Ceph volumes in pool {pool}")
        for member in self.members:
            log(f"slot {self.number}: launching MicroCloud member {member.name}")
            self.launch_member(member, pool)
        for member in self.members:
            self.wait_booted(member)
            self.run.host.exec(
                member.name,
                "nic=$(ip -4 -o route get 1.1.1.1 | sed -n 's/.* dev \\([^ ]*\\).*/\\1/p') && "
                f"ip link add link \"$nic\" name {OVN_UPLINK_INTERFACE} type vlan id {OVN_UPLINK_VLAN} && "
                f"sysctl -qw net.ipv6.conf.{OVN_UPLINK_INTERFACE}.disable_ipv6=1 && ip link set {OVN_UPLINK_INTERFACE} up",
                timeout=60,
            )
        log(f"slot {self.number}: members booted in {time.monotonic() - started:.0f} s")
        net = gateway.split("/")[0].rsplit(".", 1)[0] + ".0/" + gateway.split("/")[1]
        text = self.preseed(net)
        errors: list[str] = []

        def run_preseed(member: Sandbox) -> None:
            try:
                self.run.host.exec(
                    member.name,
                    f"printf '%s' '{text}' > /root/microcloud.yaml && microcloud preseed < /root/microcloud.yaml > /root/microcloud.log 2>&1 "
                    "|| { tail -n 30 /root/microcloud.log; exit 1; }",
                    timeout=MICROCLOUD_TIMEOUT,
                )
            except RunError as exc:
                errors.append(f"{member.name}: {exc}")

        threads = [threading.Thread(target=run_preseed, args=(member,), daemon=True) for member in self.members]
        for thread in threads:
            thread.start()
            # The initiator must listen before the others look for it.
            time.sleep(5)
        for thread in threads:
            thread.join()
        if errors:
            raise RunError("microcloud preseed failed: " + " | ".join(errors))
        log(f"slot {self.number}: MicroCloud formed in {time.monotonic() - started:.0f} s")
        first = self.members[0]
        self.run.host.exec(first.name, "lxc config trust add /etc/lxd-sandbox/client.crt --name test-client </dev/null")
        first.wait_ready()
        for member in self.members[1:]:
            member.ip = member.ip or socket.gethostbyname(member.name)
        cluster = first.api("GET", "/1.0/cluster/members?recursion=1").get("metadata") or []
        online = [item.get("server_name") for item in cluster if item.get("status") == "Online"]
        if len(online) != len(self.members):
            raise RunError(f"the MicroCloud has {len(online)} online members, not {len(self.members)}: {online}")
        # The RADOS gateway on the first member serves the cephobject pools of the bucket tests.
        self.run.host.exec(first.name, "microceph enable rgw </dev/null", timeout=600)
        self.run.host.exec(
            first.name,
            "for i in $(seq 1 60); do curl -s -o /dev/null http://127.0.0.1:80/ && exit 0; sleep 5; done; echo 'the RADOS gateway does not answer'; exit 1",
            timeout=400,
        )
        log(f"slot {self.number}: RADOS gateway ready in {time.monotonic() - started:.0f} s")
        meta = TEST_IMAGES / "alpine-ct.meta"
        root = TEST_IMAGES / "alpine-ct.root"
        if meta.exists() and root.exists():
            first.upload_split_image(meta, root, "test/alpine-ct")
        values = {
            "lxd_url": first.url,
            "lxd_client_cert": first.cert,
            "lxd_client_key": first.key,
            "lxd_server_cert": first.server_cert(self.dir / "server.crt"),
            "lxd_run_id": self.run.run_id,
            "lxd_slot": self.number,
            "lxd_sandbox_ip": first.ip,
            "lxd_sandbox_name": first.name,
            "lxd_fixture": "microcloud",
            "lxd_image_ct": "test/alpine-ct",
            "lxd_members": [member.name for member in self.members],
            "lxd_pool": "remote",
            "lxd_ceph_pool": "remote",
            "lxd_ovn_uplink": "UPLINK",
            "lxd_ovn_network": "default",
            "lxd_rgw_endpoint": f"http://{first.ip}",
        }
        self.config.parent.mkdir(parents=True, exist_ok=True)
        self.config.write_text(json.dumps(values, indent=2) + "\n")

    def cleanup(self) -> None:
        """Delete all members and their Ceph volumes."""
        host = self.run.host
        for member in self.members:
            member.delete()
        if self.volumes:
            pool = host.lxc("profile", "device", "get", f"{host.remote}:default", "root", "pool", check=False).strip()
            for volume in self.volumes:
                host.lxc("storage", "volume", "delete", f"{host.remote}:{pool}", volume, check=False, timeout=120)


def ignore_copy(directory: str, names: list[str]) -> list[str]:
    """Leave out git data, results, and test output when the runner copies the collection."""
    skip = {".git", ".nox", "ci-results", "__pycache__"}
    result = [name for name in names if name in skip]
    if directory.endswith("tests") and "output" in names:
        result.append("output")
    return result


def last_failure(text: str) -> str:
    """Return a short reason from an ansible log."""
    for line in reversed(text.splitlines()):
        if line.startswith(("fatal:", "failed:")) or "FAILED!" in line or "ERROR" in line:
            return line.strip()[:300]
    return "see the log"


class Run:
    """One run of the runner."""

    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        self.run_id = "".join(random.choices(string.ascii_lowercase + string.digits, k=4))
        self.dir = WORK / self.run_id
        self.collection = Path(args.collection).resolve()
        self.host = Host(args.remote, args.project)
        self.results = Path(args.results).resolve()
        self.slots: list[Slot] = []
        # Each queue with the slots that take tests from it. Only the standalone queue has more than one slot.
        self.queues: list[tuple[queue.Queue[Test], list[Slot]]] = []

    def main(self) -> int:
        """Run the selected tests. Return the exit code."""
        kinds = {"scenario"} if self.args.scenarios_only else ({"target"} if self.args.targets_only else {"target", "scenario"})
        tests = discover(self.collection, self.args.names, kinds)
        unknown = sorted(set(self.args.names) - {test.name for test in tests})
        if unknown:
            raise RunError(f"unknown test names, or names of another kind: {', '.join(unknown)}")
        built = ("lxd/standalone", "lxd/cluster", "lxd/cluster-new", "lxd/multicluster", "lxd/ovn", "lxd/ceph")
        tests = [test for test in tests if test.fixture in built or self.skip(test, "needs a fixture that this runner does not build yet")]
        runnable = [test for test in tests if test.status == "skip" and not test.reason]
        if not runnable:
            log("ERROR no test to run.")
            self.report(tests)
            return 2
        self.dir.mkdir(parents=True, exist_ok=True)
        standalone = [test for test in runnable if test.fixture == "lxd/standalone"]
        cluster = [test for test in runnable if test.fixture == "lxd/cluster"]
        new_cluster = [test for test in runnable if test.fixture == "lxd/cluster-new"]
        multicluster = [test for test in runnable if test.fixture == "lxd/multicluster"]
        microcloud = [test for test in runnable if test.fixture in ("lxd/ovn", "lxd/ceph")]
        side_slots = min(self.args.slots, CLUSTER_SIDE_SLOTS) if cluster else self.args.slots
        slots_wanted = max(1, min(side_slots, len(standalone))) if standalone else 0
        log(
            f"RUN {self.run_id}  tests {len(runnable)}  slots {slots_wanted}  cluster slot {'yes' if cluster else 'no'}"
            f"  multicluster slot {'yes' if multicluster else 'no'}  microcloud slot {'yes' if microcloud else 'no'}"
        )
        owner = f"{socket.gethostname()}:{self.run_id}"
        self.host.take_lock(owner, minutes=LOCK_MINUTES, wait_seconds=self.args.lock_wait * 60, adopt=self.args.lock_owner)
        beat = LockBeat(self.host, owner)
        beat.start()
        log(f"lock: held as {owner}; it expires {LOCK_MINUTES} minutes after the last renewal")
        try:
            stop_old_processes(self.run_id)
            collect_garbage(self.host, LEFTOVER_HOURS)
        except Exception as exc:  # noqa: BLE001 - the cleanup of old runs must not stop this run
            log(f"cleanup of earlier runs failed: {exc}")
        slots = self.slots
        MONITOR.start()
        try:
            jobs: queue.Queue[Test] = queue.Queue()
            for test in sorted(standalone, key=lambda item: (item.kind != "scenario", item.name)):
                jobs.put(test)
            threads = []
            standalone_slots: list[Slot] = []
            self.queues.append((jobs, standalone_slots))
            for number in range(1, slots_wanted + 1):
                slot = Slot(self, number)
                slots.append(slot)
                standalone_slots.append(slot)
                thread = threading.Thread(target=self.work, args=(slot, jobs), daemon=True)
                thread.start()
                threads.append(thread)
            special: list[tuple[type[Slot], list[Test]]] = [(ClusterSlot, cluster), (MultiClusterSlot, multicluster)]
            special_threads: list[tuple[threading.Thread, Slot]] = []
            for slot_class, selected in special:
                if not selected:
                    continue
                special_jobs: queue.Queue[Test] = queue.Queue()
                for test in sorted(selected, key=lambda item: (item.kind != "scenario", item.name)):
                    special_jobs.put(test)
                special_slot = slot_class(self, len(slots) + 1)
                slots.append(special_slot)
                self.queues.append((special_jobs, [special_slot]))
                thread = threading.Thread(target=self.work, args=(special_slot, special_jobs), daemon=True)
                thread.start()
                threads.append(thread)
                special_threads.append((thread, special_slot))
            if new_cluster:
                # Three more members would pass the CPU limit next to the cluster slot. This slot waits for it and deletes its servers.
                nc_jobs: queue.Queue[Test] = queue.Queue()
                for test in sorted(new_cluster, key=lambda item: item.name):
                    nc_jobs.put(test)
                nc_slot = NewClusterSlot(self, len(slots) + 1)
                slots.append(nc_slot)
                self.queues.append((nc_jobs, [nc_slot]))
                nc_after = [(thread, slot) for thread, slot in special_threads if isinstance(slot, ClusterSlot)]
                thread = threading.Thread(target=self.work_after, args=(nc_slot, nc_jobs, nc_after), daemon=True)
                thread.start()
                threads.append(thread)
            if microcloud:
                # Start the MicroCloud at once only when the CPU limit of the project has room for it next to the other slots.
                # The cluster-new slot runs at once when no cluster slot runs, so its members count then.
                new_now = bool(new_cluster) and not cluster
                cpus = runner_cpus() + 2 * slots_wanted + (CLUSTER_MEMBERS if cluster or new_now else 0) + (2 if multicluster else 0)
                limit = self.host.cpu_limit()
                after = special_threads if limit and cpus + MICROCLOUD_MEMBERS * MICROCLOUD_CPU > limit else []
                if after:
                    log(f"the MicroCloud slot waits for the cluster slots: {cpus} of {limit} CPUs are in use")
                mc_jobs: queue.Queue[Test] = queue.Queue()
                for test in sorted(microcloud, key=lambda item: (item.kind != "scenario", item.name)):
                    mc_jobs.put(test)
                mc_slot = MicroCloudSlot(self, len(slots) + 1)
                slots.append(mc_slot)
                self.queues.append((mc_jobs, [mc_slot]))
                thread = threading.Thread(target=self.work_after, args=(mc_slot, mc_jobs, after), daemon=True)
                thread.start()
                threads.append(thread)
            for thread in threads:
                thread.join()
            self.fail_stranded()
        finally:
            for test in runnable:
                if test.status == "skip" and not test.reason:
                    test.status = "error"
                    test.reason = "not run"
            if not (self.args.keep_on_failure and any(test.status != "pass" for test in runnable)):
                for slot in slots:
                    guarded(f"cleanup of slot {slot.number}", slot.cleanup)
            guarded("probe summary", MONITOR.finish)
            beat.stop()
            guarded("lock release", self.host.release_lock)
        return self.report(tests)

    def skip(self, test: Test, reason: str) -> bool:
        """Mark a test as skipped with a reason. Return True, so that the test stays in the report."""
        test.status = "skip"
        test.reason = reason
        return True

    def work_after(self, slot: Slot, jobs: queue.Queue[Test], wait_for: list[tuple[threading.Thread, Slot]]) -> None:
        """Wait for other slots to finish, delete their servers to free the CPUs, then work like L(work).

        With --keep-on-failure, the servers of a slot with a failed test stay. The project limit can then stop this slot.
        """
        for thread, other in wait_for:
            thread.join()
            if not (self.args.keep_on_failure and other.failed):
                other.cleanup()
        self.work(slot, jobs)

    def fail_stranded(self) -> None:
        """Mark the tests that no slot could run. Call this after all slot threads have ended.

        A slot that started takes tests until its queue is empty. So a test is still in a queue only when every slot of
        that queue did not start.
        """
        for jobs, slots in self.queues:
            errors = "; ".join(f"slot {slot.number}: {slot.start_error}" for slot in slots if slot.start_error)
            if not errors:
                continue
            while True:
                try:
                    test = jobs.get_nowait()
                except queue.Empty:
                    break
                test.status = "error"
                test.reason = f"the sandbox did not start: {errors}"

    def work(self, slot: Slot, jobs: queue.Queue[Test]) -> None:
        """Prepare one slot, then run tests from the queue.

        A slot that does not start takes no test. Its tests stay in the queue for the other slots of the queue.
        L(fail_stranded) marks the tests that are left when no slot of the queue started.
        """
        try:
            slot.prepare()
        except Exception as exc:  # noqa: BLE001 - any fixture error stops only this slot, and the thread ends cleanly
            slot.start_error = f"{type(exc).__name__}: {exc}"
            log(f"WARNING slot {slot.number}: the sandbox did not start, so this slot runs no test: {slot.start_error}")
            return
        while True:
            try:
                test = jobs.get_nowait()
            except queue.Empty:
                return
            try:
                slot.execute(test)
            except Exception as exc:  # noqa: BLE001 - a runner error fails this test, and the slot goes on
                log(f"slot {slot.number}: runner error in {test.name}: {type(exc).__name__}: {exc}")
                test.status = "error"
                test.reason = f"runner: {type(exc).__name__}: {exc}"
                slot.failed = True

    def report(self, tests: list[Test]) -> int:
        """Write the summary and the JUnit file. Return the exit code."""
        self.results.mkdir(parents=True, exist_ok=True)
        counts = {status: sum(1 for test in tests if test.status == status) for status in ("pass", "fail", "error", "timeout", "skip")}
        not_started = [slot for slot in self.slots if slot.start_error]
        summary = {
            "run_id": self.run_id,
            "counts": counts,
            "slots_not_started": [{"slot": slot.number, "error": slot.start_error} for slot in not_started],
            "tests": [
                {"kind": t.kind, "name": t.name, "goal": t.goal, "status": t.status, "reason": t.reason, "seconds": round(t.seconds, 1)}
                for t in tests
            ],
        }
        (self.results / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
        suite = ET.Element("testsuite", name="lxdtest", tests=str(len(tests)),
                           failures=str(counts["fail"] + counts["timeout"]), errors=str(counts["error"]), skipped=str(counts["skip"]))
        for test in tests:
            case = ET.SubElement(suite, "testcase", classname=test.kind, name=test.name, time=f"{test.seconds:.1f}")
            if test.status in ("fail", "timeout"):
                ET.SubElement(case, "failure", message=test.reason).text = test.log[-20000:]
            elif test.status == "error":
                ET.SubElement(case, "error", message=test.reason)
            elif test.status == "skip":
                ET.SubElement(case, "skipped", message=test.reason)
        ET.ElementTree(suite).write(self.results / "junit.xml", encoding="unicode", xml_declaration=True)
        logs = self.dir / "logs"
        if logs.exists():
            shutil.copytree(logs, self.results / "logs", dirs_exist_ok=True)
        print()
        for test in tests:
            reason = f"  {test.reason}" if test.reason and test.status != "pass" else ""
            print(f"{test.status.upper():8} {test.kind:9} {test.name:32} {test.seconds:6.0f} s{reason}")
        print(f"\nRUN {self.run_id}  " + "  ".join(f"{k} {v}" for k, v in counts.items()))
        # A slot that did not start does not fail the run by itself: the result of the run is the result of its tests.
        # The tests of such a slot ran on the other slots of its queue, or they are errors above.
        for slot in not_started:
            print(f"WARNING slot {slot.number} did not start, the run had fewer slots: {slot.start_error}")
        if counts["error"]:
            return 2
        if counts["fail"] or counts["timeout"]:
            return 1
        return 0


def guarded(what: str, action: t.Callable[[], object]) -> None:
    """Run one cleanup step. Log an error and go on, so that the next steps still run."""
    try:
        action()
    except Exception as exc:  # noqa: BLE001 - one failed cleanup step must not skip the others
        log(f"{what} failed: {type(exc).__name__}: {exc}")


def hours_value(text: str) -> float:
    """Parse a number of hours, for example 6 or 6h."""
    return float(text.removesuffix("h"))


def gc(args: argparse.Namespace) -> int:
    """Delete sandbox VMs and work directories older than the limit."""
    collect_garbage(Host(args.remote, args.project), args.older_than)
    return 0


def collect_garbage(host: Host, hours: float) -> None:
    """Delete sandbox VMs, their volumes and work directories older than O(hours)."""
    limit = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(hours=hours)
    for inst in host.instances():
        name = inst.get("name", "")
        if not name.startswith("sbx-"):
            continue
        created = datetime.datetime.fromisoformat(inst["created_at"].replace("Z", "+00:00"))
        if created < limit:
            log(f"deleting {name}")
            host.lxc("delete", host.name(name), "--force", check=False, timeout=DELETE_TIMEOUT)
    pool = host.lxc("profile", "device", "get", f"{host.remote}:default", "root", "pool", check=False).strip()
    if pool:
        volumes = json.loads(host.lxc("storage", "volume", "list", f"{host.remote}:{pool}", "type=custom", "--format", "json", check=False) or "[]")
        for volume in volumes:
            name = volume.get("name", "")
            created = datetime.datetime.fromisoformat((volume.get("created_at") or "1970-01-01T00:00:00Z").replace("Z", "+00:00"))
            if name.startswith("sbx-") and not volume.get("used_by") and created < limit:
                log(f"deleting volume {name}")
                host.lxc("storage", "volume", "delete", f"{host.remote}:{pool}", name, check=False)
    if WORK.exists():
        for path in WORK.iterdir():
            if path.is_dir() and path.stat().st_mtime < limit.timestamp():
                shutil.rmtree(path, ignore_errors=True)


def main() -> int:
    """Parse the command line and run."""
    parser = argparse.ArgumentParser(prog="lxdtest")
    parser.add_argument("--remote", default=DEFAULT_REMOTE)
    parser.add_argument("--project", default=DEFAULT_PROJECT)
    sub = parser.add_subparsers(dest="command", required=True)
    run = sub.add_parser("run", help="Run targets and scenarios.")
    run.add_argument("names", nargs="*", help="Target or scenario names. Empty means all.")
    run.add_argument("--collection", default=str(Path(__file__).resolve().parents[2]))
    run.add_argument("--slots", type=int, default=4)
    run.add_argument("--image", default=DEFAULT_IMAGE)
    run.add_argument("--results", default="ci-results")
    run.add_argument("--timeout", type=int, default=20, help="Minutes per test.")
    run.add_argument("--lock-wait", type=int, default=120, help="Minutes to wait for the lock.")
    run.add_argument("--keep-on-failure", action="store_true")
    run.add_argument("--lock-owner", default="", help="Take over a lock with this owner, for example from ci/bootstrap.py.")
    run.add_argument("--scenarios-only", action="store_true")
    run.add_argument("--targets-only", action="store_true")
    run.add_argument("-v", "--verbose", action="store_true")
    clean = sub.add_parser("gc", help="Delete old sandboxes and work directories.")
    clean.add_argument("--older-than", type=hours_value, default=6, help="Hours, for example 6 or 6h.")
    args = parser.parse_args()
    if not args.remote or not args.project:
        parser.error(f"set --remote and --project, LXDTEST_REMOTE and LXDTEST_PROJECT, or {CONFIG_FILE} (ci/bootstrap.py writes it)")
    try:
        if args.command == "gc":
            return gc(args)
        # A SIGTERM (a stopped job or runner) ends the run through its finally blocks: cleanup and lock release.
        signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))
        return Run(args).main()
    except RunError as exc:
        log(f"ERROR {exc}")
        return 2


if __name__ == "__main__":
    sys.exit(main())
