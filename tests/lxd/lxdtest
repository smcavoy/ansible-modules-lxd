CONFIG_FILE = Path(os.environ.get("LXDTEST_CONFIG", "/etc/lxdtest/config.json"))


def setting(name: str, default: str = "") -> str:
    """Return a setting from the environment, else from the config file of the bootstrap."""
    value = os.environ.get(f"LXDTEST_{name.upper()}", "")
    if value:
        return value
    try:
        data = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        data = {}
    return str(data.get(name) or default) if isinstance(data, dict) else default


