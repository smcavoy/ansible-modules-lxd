def log(msg: str) -> None:
    """Print one timestamped line."""
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S")
    print(f"[{stamp}] {msg}", flush=True)


class RunError(Exception):
    """A fixture step failed."""


