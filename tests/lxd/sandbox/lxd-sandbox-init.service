[Unit]
Description=Set up LXD in a test sandbox on first boot
After=snap.lxd.daemon.unix.socket snap.lxd.daemon.socket network-online.target lxd-agent.service
Wants=network-online.target
ConditionPathExists=!/var/lib/lxd-sandbox/done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lxd-sandbox-init

[Install]
WantedBy=multi-user.target
