extends: default

ignore: |
  /.nox/
  /tests/output/
  # antsibull-changelog writes this file in its own style on each release.
  /changelogs/changelog.yaml

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  document-start:
    present: true
